# Copy to .env (gitignored). Never commit secrets.
# Paths
VS_CONFIG_DIR=./configs
VS_DATA_DIR=./data

# Model endpoints. For the demo, the 14B agents on Ada are reached through an SSH tunnel (plan §13.1).
VS_VLLM_BASE_URL=http://localhost:8001/v1
VS_VLLM_MODEL=Qwen/Qwen3-14B-AWQ
VS_LOCAL_LLM_DEVICE=cuda:0

# Teacher API (optional; public training orders ONLY; see plan §17 pilot). Leave empty to use Qwen3-32B on Ada.
MISTRAL_API_KEY=

# Hugging Face (model downloads)
HF_TOKEN=

# Ada cluster
ADA_USER=
ADA_SCRATCH=/scratch/${ADA_USER}/vakeel_sahayak

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
