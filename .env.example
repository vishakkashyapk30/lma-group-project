# Copy to .env (gitignored). Never commit secrets.
# Paths
VS_CONFIG_DIR=./configs
VS_DATA_DIR=./data

# Model endpoints. For the demo, the 14B agents on Ada are reached through an SSH tunnel (plan §13.1).
VS_VLLM_BASE_URL=http://localhost:8001/v1
VS_VLLM_MODEL=Qwen/Qwen3-14B-AWQ
VS_LOCAL_LLM_DEVICE=cuda:0

# Teacher API (optional; public training orders ONLY; see plan §17 pilot). Leave empty to use Qwen3-32B on Ada.
MISTRAL_API_KEY=

# Hugging Face (model downloads)
HF_TOKEN=

# Ada cluster
ADA_USER=
ADA_SCRATCH=/scratch/${ADA_USER}/vakeel_sahayak

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sarvam AI (external API; OFF by default). The key lives ONLY here in your untracked .env or the shell; never commit it.
# VS_SARVAM: off | public | pseudonymised | consented (see configs/models.yaml `sarvam:` and plan section 16).
# Set Sarvam's workspace data retention to the shortest/zero option before using anything above `public`.
SARVAM_API_KEY=
VS_SARVAM=off

# OpenAI (external API; OFF by default; hosted LLMs are allowed, team budget 5.00 USD in total). The key lives ONLY here in your untracked
# .env or the shell; never commit it. Every call is checked against a persisted spend ledger first (`make openai-spend` prints it).
OPENAI_API_KEY=
# Spending cap in USD. 4.50 leaves a 0.50 safety margin; values above 5.00 are clamped to 5.00 in code.
VS_OPENAI_CAP_USD=4.50
# Optional soft cap for one run (USD), never above the cap above.
VS_OPENAI_RUN_CAP_USD=
# Which LLM answers the agent roles: offline | local | sarvam | openai (offline = deterministic stand-in, the safe default).
# openai / sarvam fall back to the local/offline client when blocked, over the cap or failing. Set VS_MODELS accordingly (offline forces offline everywhere).
VS_LLM_BACKEND=offline
# Privacy gate for EVERY external provider: off | public | pseudonymised | consented (VS_SARVAM stays an alias for Sarvam only).
# public = public/constructed data only; pseudonymised = + boundary-checked client text; consented = + raw pages, per case with counsel's consent.
VS_EXTERNAL=off
# Optional non-Qwen evaluation labeler / teacher (public orders only): VS_LABELER=openai|sarvam, VS_TEACHER=openai|sarvam

# ---- Docker Compose (see DOCKER.md; compose.yaml reads these) ----
# Host ports and bind address. 127.0.0.1 keeps the stack private to this machine (plan section 16); use 0.0.0.0 to expose it.
BIND_ADDR=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Model mode for the backend: offline (no models, default) | real (needs the `real` profile) | auto
VS_MODELS=offline
# Origins the backend's CORS accepts, comma separated. Only matters when the browser calls the backend directly.
VS_CORS_ORIGINS=http://localhost:3000
# Frontend -> backend. "/backend" (default) = same-origin proxy through the Next server, works from any browser host.
# Inlined at build time: after changing it run `docker compose build frontend`. Absolute URL = direct calls; "demo" = demo backend only.
NEXT_PUBLIC_API_BASE=/backend
# Image tag for the locally built images
IMAGE_TAG=latest
# `real` profile only: vLLM image tag, context length, GPU memory share, and the ports of the second stack
VLLM_IMAGE_TAG=v0.10.2
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_UTIL=0.85
BACKEND_REAL_PORT=8001
FRONTEND_REAL_PORT=3001
VS_CORS_ORIGINS_REAL=http://localhost:3001
# `test` profile only: must match @playwright/test in frontend/package-lock.json
PLAYWRIGHT_VERSION=1.64.0

# ---- Fresh clone and data scripts (make setup, make data) ----
# Hugging Face token for `make data` and `make models`: a fine-grained token with "Read access to contents of all repos" under Org permissions
# for Vakeel-Sahayak (https://huggingface.co/settings/tokens), or run `hf auth login` instead. Set HF_TOKEN= above.
# Slow link or tight disk (shell variables, normally not needed in .env): HF_HUB_DOWNLOAD_TIMEOUT (60), HF_HUB_ETAG_TIMEOUT (30), HF_MAX_WORKERS (2),
# HF_TRIES (3), TMPDIR=<big disk> (download scratch), VS_DOWNLOAD_DIR=<folder> (keep the download between runs), RAW=0 (skip the 1.8 GB raw archive),
# EXTRAS=dev,data,eval (make setup extras).

# ---- Optional tunables: commented out so the defaults apply; uncomment to change (each is read by the code; see the module named in docs/) ----
# VS_MODELS_DIR=            # model weights folder (default models/hf)
# VS_EMBEDDER=              # hashed-ngram | bge-m3 | auto (stores and retrieval)
# VS_STORES=                # bge: the four vector stores search their opt-in BGE-M3 side vectors (*.bge.sqlite; needs models/hf/BAAI--bge-m3 and sentence-transformers); unset: the stores as built
# VS_NLI=                   # offline: never load DeBERTa (tests, runs without torch)
# VS_NLI_MODEL=             # alternative NLI model id or path
# VS_HEAVY_CLIENTS=         # offline: keep vision, OCR, ASR and translation clients offline even with VS_MODELS=auto
# VS_ALLOW_LOCAL_FALLBACK=  # 1: let the 14B agents fall back to the laptop model
# VS_VLLM_API_KEY=          # bearer token of the vLLM endpoint, if any
# VS_VLLM_TP=               # vLLM tensor-parallel size
# VS_LABELER=               # openai | sarvam: hosted non-Qwen labeler (public orders only)
# VS_TEACHER=               # openai | sarvam: hosted non-Qwen teacher (public orders only)
# VS_OPENAI_RUN_ID=         # label of one OpenAI run (its run cap spans the run)
# VS_OPENAI_NO_CACHE=       # 1: measurement runs, every call is real and billed
# VS_SARVAM_CAP_INR=        # Sarvam spend cap in INR (default 25, ceiling 500)
# VS_PESHKAR_WORKERS=       # threads for the dossier field readings (default 1 offline, 4 hosted)
# VS_BM25_PRUNE=            # 0: keep every BM25 term (no pruning)
# VS_SCC_LINK=              # off: earlier SCC citation resolution
# VS_CORPUS_METADATA=       # corpus metadata file (default data/interim/metadata.jsonl or orders.jsonl)
# VS_STORE_PRIOR=           # path of eval/store_prior.json
# VS_FONT_DEVANAGARI=       # a Devanagari font file for the test-set builders
# VS_WORDLISTS=             # extra word lists (path-separated) for the test-set builders
# VS_FEATURE_N=             # feature runs F1-F8: first N cases
# VS_FEATURE_ARMS=          # feature runs: comma list of arms
# VS_FEATURE_CASES=         # feature runs: case ids
# VS_F4_STAGE2=             # F4: run the first N T1 cases end to end
# VS_F7_BRIEFS_N=           # F7: number of briefs
# REQUIRE_MODELS=           # 1: make data-check requires the T1 models
# REQUIRE_RAW=              # 1: make data-check requires the raw source data
